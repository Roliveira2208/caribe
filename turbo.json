{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // Turbo 2 corre las tareas en modo estricto: solo las variables
      // declaradas aqui llegan al proceso. Los e2e de la API necesitan la BD
      // del job de CI; sin esto, setup-env.ts cae al default local (:5433).
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "TRUSTED_ORIGINS",
        "TRUSTED_PROXIES",
        "RATE_LIMIT_WINDOW_SECONDS",
        "RATE_LIMIT_BOOKINGS_MAX",
        "RATE_LIMIT_PAYMENTS_MAX",
        "RATE_LIMIT_PAYMENT_REVIEWS_MAX",
        "RATE_LIMIT_DOWNLOADS_MAX",
        "REDIS_URL"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "TRUSTED_ORIGINS",
        "TRUSTED_PROXIES",
        "RATE_LIMIT_WINDOW_SECONDS",
        "RATE_LIMIT_BOOKINGS_MAX",
        "RATE_LIMIT_PAYMENTS_MAX",
        "RATE_LIMIT_PAYMENT_REVIEWS_MAX",
        "RATE_LIMIT_DOWNLOADS_MAX",
        "REDIS_URL",
        "API_URL",
        "WEB_URL",
        "ADMIN_URL",
        "ALLOWED_IMAGE_HOSTS",
        "COTIZAVE_API_URL",
        "COTIZAVE_API_KEY",
        "DOCUMENTS_DIR",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "SMTP_FROM",
        "PENDING_RECOVERY_MINUTES"
      ]
    }
  }
}
