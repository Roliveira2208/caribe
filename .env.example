# ---------------------------------------------------------------------------
# Caribe — variables de entorno de desarrollo
# Copia este archivo a .env y ajusta los valores: cp .env.example .env
# .env nunca se sube al repositorio. Los valores de abajo son de desarrollo.
# ---------------------------------------------------------------------------

# Entorno
NODE_ENV=development

# PostgreSQL (docker compose lee estas variables; DATABASE_URL debe usar las
# mismas credenciales). Prisma (T-F0-4) consume DATABASE_URL.
# Puertos locales 5433/6380 para no chocar con otros proyectos locales.
POSTGRES_USER=caribe_dev
POSTGRES_PASSWORD=caribe_dev_password
POSTGRES_DB=caribe_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://caribe_dev:caribe_dev_password@localhost:5433/caribe_dev?schema=public

# Contrasena del rol restringido caribe_app (migracion 20261110022152): la app
# debe conectar como ese rol porque respeta RLS. Se asigna en local con
# `pnpm db:app-password` y nunca se versiona. Para probarlo, apunta DATABASE_URL
# a caribe_app con esta contrasena.
CARIBE_APP_DB_PASSWORD=

# Redis (caché y BullMQ)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Better Auth (T-F0-5). Genera el secrete con: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-random-secret
BETTER_AUTH_URL=http://localhost:3002
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# URLs de las apps (reenvios /api/* en web y admin para la cookie de primera parte)
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:3002

# --- F1: tasas y notificaciones -------------------------------------------
# Fuente primaria de tasa BCV (publica, sin autenticacion)
DOLARAPI_URL=https://ve.dolarapi.com/v1/dolares/oficial
# Correo transaccionales (SMTP local de desarrollo, p. ej. Mailpit)
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Caribe <no-reply@example.com>"

# --- F4: proveedores sandbox (claves de prueba, nunca de produccion) -------
DUFFEL_TEST_TOKEN=
LITEAPI_KEY=
LITEAPI_BASE_URL=https://api.sandbox.liteapi.travel
