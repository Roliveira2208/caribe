# ---------------------------------------------------------------------------
# Caribe — variables de entorno de desarrollo
# Copia este archivo a .env y ajusta los valores: cp .env.example .env
# .env nunca se sube al repositorio. Los valores de abajo son de desarrollo.
# ---------------------------------------------------------------------------

# Entorno
NODE_ENV=development

# PostgreSQL (docker compose lee estas variables; DATABASE_URL debe usar las
# mismas credenciales). Prisma (T-F0-4) consume DATABASE_URL.
# Puertos locales 5433/6380 para no chocar con otros proyectos locales.
POSTGRES_USER=caribe_dev
POSTGRES_PASSWORD=caribe_dev_password
POSTGRES_DB=caribe_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://caribe_dev:caribe_dev_password@localhost:5433/caribe_dev?schema=public
# BD vacia dedicada al replay de migraciones de Prisma 7 (migrate dev/diff la
# exigen en prisma7.config.ts). Creala una vez tras levantar el compose:
#   docker exec caribe-postgres-1 psql -U caribe_dev -d caribe_dev -c "CREATE DATABASE caribe_shadow"
# El CLI la resetea en cada uso; nunca apunta a la BD de desarrollo.
SHADOW_DATABASE_URL=postgresql://caribe_dev:caribe_dev_password@localhost:5433/caribe_shadow

# Contrasena del rol restringido caribe_app (migracion 20261110022152): la app
# debe conectar como ese rol porque respeta RLS. Se asigna en local con
# `pnpm db:app-password` y nunca se versiona. Para probarlo, apunta DATABASE_URL
# a caribe_app con esta contrasena.
CARIBE_APP_DB_PASSWORD=

# Redis (caché y BullMQ)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# Better Auth (T-F0-5). Genera el secrete con: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-random-secret
BETTER_AUTH_URL=http://localhost:3002
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# Proxies de confianza para resolver la IP real (T-F2-2): IPs o rangos CIDR
# separados por comas. Vacío = conexión directa; las cabeceras de reenvío se
# ignoran. En producción indica la IP del balanceador o reverse proxy.
TRUSTED_PROXIES=

# URLs de las apps (reenvios /api/* en web y admin para la cookie de primera parte)
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:3002

# --- F1: tasas y notificaciones -------------------------------------------
# Dominios permitidos para las imagenes del catalogo, separados por comas y
# sin esquema. Una lista vacia rechaza todas las imagenes (fallo cerrado).
ALLOWED_IMAGE_HOSTS=images.caribe.test
# Fuente de la tasa BCV oficial (Cotizave V2). La clave va solo en la
# cabecera X-API-Key; nunca en la URL ni en los logs. Sin clave, la fuente se
# considera caída y se usa la última tasa guardada.
COTIZAVE_API_URL=https://api.cotizave.com/v2/fx/VE/rates
COTIZAVE_API_KEY=ctz_live_reemplaza_esta_clave
# PDF de documentos (T-F1-11). Ruta absoluta FUERA del repositorio: la API crea
# el directorio al arrancar y falla si no puede escribir. Los nombres son UUID.
# En Windows usa, por ejemplo, C:/caribe-documents
DOCUMENTS_DIR=/tmp/caribe-documents
# Correo transaccional: Mailpit (levantado por `pnpm db:up`) escucha en 1025.
# Pon SMTP_HOST=localhost para ver los correos en http://localhost:8025.
# Mailpit no envía nada a Internet; en tests el proveedor se dobla.
SMTP_HOST=
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Caribe <no-reply@example.com>"
# Barrido de documentos y avisos PENDING huérfanos (T-F1-12b): cada minuto se
# re-encolan los que lleven más de este número de minutos sin procesarse.
PENDING_RECOVERY_MINUTES=5

# --- F4: proveedores sandbox (claves de prueba, nunca de produccion) -------
DUFFEL_TEST_TOKEN=
LITEAPI_KEY=
LITEAPI_BASE_URL=https://api.sandbox.liteapi.travel
