{
  "name": "caribe",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @caribe/api generate",
    "db:migrate:dev": "pnpm --filter @caribe/api migrate:dev",
    "db:migrate:deploy": "pnpm --filter @caribe/api migrate:deploy",
    "db:seed": "turbo run build --filter=@caribe/api && pnpm --filter @caribe/api seed",
    "db:app-password": "node scripts/set-caribe-app-password.mjs"
  },
  "devDependencies": {
    "@caribe/eslint-config": "workspace:*",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
