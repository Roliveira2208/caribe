{
  "name": "@caribe/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "start": "node dist/main.js",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "seed": "node dist/seed-main.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@caribe/shared": "workspace:*",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/throttler": "6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.18",
    "bullmq": "6.7.6",
    "dotenv": "18.0.9",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "nodemailer": "7.0.11",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@caribe/eslint-config": "workspace:*",
    "@caribe/tsconfig": "workspace:*",
    "@types/nodemailer": "7.0.11",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "eslint": "^10.14.0",
    "prisma": "7.10.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
