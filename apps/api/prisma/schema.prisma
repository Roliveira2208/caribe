// Esquema de las tablas de Better Auth (core + plugins organization, admin y
// twoFactor), generado con el CLI oficial del adaptador de Prisma:
//
//   pnpm dlx @better-auth/cli@1.4.21 generate --config auth.ts --output schema.prisma -y
//
// con un auth.ts que monta betterAuth({ database: prismaAdapter(..., {
// provider: "postgresql" }), plugins: [organization(), admin(), twoFactor()] });
// (ese auth.ts se crea en T-F0-5). No editar a mano: regenerar y validar el
// diff con `prisma migrate dev`.
//
// Adaptado al formato de Prisma 7: generador prisma-client (el CLI escribe
// prisma-client-js) y la URL del datasource vive en prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id
  name             String
  email            String
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  role             String?
  banned           Boolean?     @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?     @default(false)
  // Idioma de la interfaz (additionalFields de Better Auth, T-F1-1a). Lo
  // genera el CLI a partir de auth.ts; no editar a mano.
  locale           String?      @default("es")
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  twofactors       TwoFactor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                     String    @id
  accountId              String
  providerId             String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  // Relación 1:1 con la tabla propia tenant_settings. El CLI de Better Auth
  // NO genera este campo (ni el modelo TenantSettings): al regenerar el
  // esquema hay que volver a añadirlo para que `prisma migrate diff` quede
  // limpio con la FK a organization.id.
  tenantSettings TenantSettings?
  // Relaciones propias de F1 (T-F1-1b). Tampoco las genera el CLI de Better
  // Auth: al regenerar hay que volver a añadirlas junto con sus modelos.
  providers            Provider[]
  destinations         Destination[]
  products             Product[]
  availability         Availability[]
  cancellationPolicies CancellationPolicy[]
  // Relaciones propias de F1 (T-F1-1c). Tampoco las genera el CLI de Better
  // Auth: al regenerar hay que volver a añadirlas junto con sus modelos.
  bookings         Booking[]
  bookingItems     BookingItem[]
  exchangeRates    ExchangeRate[]
  payments         Payment[]
  refunds          Refund[]
  refundDispatches RefundDispatch[]
  documents        Document[]
  documentCounters DocumentCounter[]
  notificationLogs NotificationLog[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// Tabla propia de Caribe (no de Better Auth): rastro inmutable de acciones
// sensibles (specs/audit). Sin relaciones Prisma a User/Organization a
// proposito: la historia de auditoria sobrevive al borrado de usuarios y
// agencias, y tocar los modelos generados por el CLI de Better Auth los
// haria perder campos en la proxima regeneracion. La coherencia de
// tenant_id/actor_id la garantiza la capa de aplicacion (interceptor de
// T-F0-9), que toma la organizacion activa de la sesion verificada.
//
// RLS (migracion SQL, invisible para Prisma): las politicas comparan
// tenant_id con el GUC app.tenant_id que fija TenantService por
// transaccion; app.platform='on' habilita el contexto de plataforma.
// caribe_app (NOBYPASSRLS, no duena) siempre respeta las politicas.
model AuditLog {
  id       String   @id
  tenantId String?  @map("tenant_id")
  actorId  String?  @map("actor_id")
  action   String
  entity   String
  entityId String   @map("entity_id")
  before   Json?
  after    Json?
  ip       String?
  at       DateTime @default(now())

  @@index([tenantId])
  @@map("audit_logs")
}

// Tabla propia de Caribe (no de Better Auth): intentos y resultados de las
// escrituras administrativas de Better Auth y de los rechazos por segundo
// factor (delta de audit, T-F1-0b). Separada de audit_logs a proposito:
// audit_logs conserva la accion sensible confirmada con antes/despues y un
// intento NUNCA se escribe alli. Append-only con trigger y RLS por tenant_id
// (migracion SQL, invisible para Prisma). Dos filas por intento unidas por
// correlation_id: phase attempt y phase result.
model AuthEvent {
  id            String   @id
  tenantId      String?  @map("tenant_id")
  correlationId String   @map("correlation_id")
  phase         String
  actorId       String?  @map("actor_id")
  route         String
  method        String
  ip            String?
  outcome       String?
  errorCode     String?  @map("error_code")
  errorStatus   Int?     @map("error_status")
  errorName     String?  @map("error_name")
  entity        String?
  entityId      String?  @map("entity_id")
  at            DateTime @default(now())

  @@index([tenantId])
  @@index([correlationId])
  @@index([at, id])
  @@map("auth_events")
}

// Modo de cobro de la agencia (T-F1-1a, specs/auth-access y design §2.1).
// AUTO cobra en línea; MANUAL exige aprobación del admin. La base impone el
// enum: cualquier otro valor es imposible incluso por SQL directo.
enum PaymentMode {
  AUTO
  MANUAL
}

// Ajustes operativos de la agencia (T-F1-1a, design §2.1): tabla propia 1:1
// con organization.id, separada del modelo que genera Better Auth. Las
// columnas de contacto son opcionales; los defaults de negocio son 30
// minutos, cobro AUTO y USD. La base refuerza los límites con CHECK
// (hold_minutes 5-1440 y base_currency ISO de 3 mayúsculas) y RLS forzada
// con política de agencia (FOR ALL) y de plataforma (solo lectura), en la
// migración SQL invisible para Prisma.
model TenantSettings {
  tenantId     String      @id @map("tenant_id")
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  holdMinutes  Int         @default(30) @map("hold_minutes")
  paymentMode  PaymentMode @default(AUTO) @map("payment_mode")
  baseCurrency String      @default("USD") @map("base_currency")
  legalName    String?     @map("legal_name")
  rif          String?
  address      String?
  phone        String?
  email        String?
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

// Catálogo de F1 (T-F1-1b, design §2.2). Cada fila de Product es un tipo de
// habitación vendible: hotel_key agrupa los tipos del mismo hotel y room_type
// los distingue. No hay tabla hotels en F1; stars, amenities e images se
// repiten en cada tipo y la normalización queda para F2.
enum ProductType {
  HOTEL
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductSource {
  OWN
}

model Provider {
  id        String   @id
  tenantId  String   @map("tenant_id")
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  name      String
  contact   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  products  Product[]

  @@index([tenantId])
  @@map("providers")
}

model Destination {
  id        String   @id
  tenantId  String   @map("tenant_id")
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      Json
  country   String
  code      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  products  Product[]

  @@index([tenantId])
  @@map("destinations")
}

model CancellationPolicy {
  id        String   @id
  tenantId  String   @map("tenant_id")
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  rules     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  products  Product[]

  @@index([tenantId])
  @@map("cancellation_policies")
}

model Product {
  id                   String             @id
  tenantId             String             @map("tenant_id")
  organization         Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId           String             @map("provider_id")
  provider             Provider           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  type                 ProductType
  hotelKey             String             @map("hotel_key")
  roomType             String             @map("room_type")
  title                Json
  description          Json
  destinationId        String             @map("destination_id")
  destination          Destination        @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  status               ProductStatus      @default(DRAFT)
  basePriceUsd         Decimal            @db.Decimal(14, 2) @map("base_price_usd")
  cancellationPolicyId String?            @map("cancellation_policy_id")
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)
  source               ProductSource      @default(OWN)
  externalRef          String?            @map("external_ref")
  attributes           Json
  deletedAt            DateTime?          @map("deleted_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  availability         Availability[]
  bookingItems         BookingItem[]

  @@index([tenantId, type, destinationId, status])
  @@index([type, destinationId, status, deletedAt])
  @@index([hotelKey])
  @@map("products")
}

model Availability {
  id        String   @id
  tenantId  String   @map("tenant_id")
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  night     DateTime @db.Date
  capacity  Int
  reserved  Int      @default(0)
  priceUsd  Decimal  @db.Decimal(14, 2) @map("price_usd")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, night])
  @@index([night, productId])
  @@map("availability")
}

// Reservas, pagos, documentos y avisos de F1 (T-F1-1c, design §2.3–2.7).
// Igual que en el catálogo, RLS, CHECK, índices parciales y triggers viven en
// la migración SQL: Prisma no los modela. Los campos de usuario (user_id,
// reported_by, reviewed_by, created_by) no llevan relación a User, como en
// providers.user_id: el CLI de Better Auth no debe perderlos al regenerar y
// los datos de negocio sobreviven a cambios de cuenta.
enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  PAGO_MOVIL
  ZELLE
  BINANCE_PAY
  CARD
}

enum PaymentStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DocumentType {
  VOUCHER
  RECEIPT
  REFUND_NOTE
}

enum DocumentStatus {
  PENDING
  READY
  FAILED
}

enum DocumentLanguage {
  ES @map("es")
  EN @map("en")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Booking {
  id          String        @id
  tenantId    String        @map("tenant_id")
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  userId      String        @map("user_id")
  status      BookingStatus @default(PENDING_PAYMENT)
  totalUsd    Decimal       @db.Decimal(14, 2) @map("total_usd")
  travelers   Json
  expiresAt   DateTime      @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  items       BookingItem[]
  payments    Payment[]
  refunds     Refund[]
  documents   Document[]

  @@unique([code])
  @@index([tenantId, status, createdAt])
  @@index([userId, createdAt])
  @@map("bookings")
}

model BookingItem {
  id             String       @id
  bookingId      String       @map("booking_id")
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenantId       String       @map("tenant_id")
  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId      String       @map("product_id")
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  hotelKey       String       @map("hotel_key")
  roomType       String       @map("room_type")
  checkIn        DateTime     @db.Date @map("check_in")
  checkOut       DateTime     @db.Date @map("check_out")
  quantity       Int
  nightlyPrices  Json         @map("nightly_prices")
  subtotalUsd    Decimal      @db.Decimal(14, 2) @map("subtotal_usd")
  productTitle   Json         @map("product_title")
  policySnapshot Json         @map("policy_snapshot")

  @@index([bookingId])
  @@index([tenantId])
  @@index([productId])
  @@map("booking_items")
}

model IdempotencyKey {
  id             String   @id
  userId         String   @map("user_id")
  endpoint       String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model ExchangeRate {
  id         String       @id
  tenantId   String?      @map("tenant_id")
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source     String
  rate       Decimal      @db.Decimal(18, 4)
  valueDate  DateTime     @db.Date @map("value_date")
  fetchedAt  DateTime     @map("fetched_at")
  isOverride Boolean      @default(false) @map("is_override")
  reason     String?
  createdBy  String?      @map("created_by")
  payments   Payment[]
  refunds    Refund[]

  @@unique([tenantId, valueDate])
  @@index([valueDate])
  @@map("exchange_rates")
}

model Payment {
  id              String        @id
  tenantId        String        @map("tenant_id")
  organization    Organization  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingId       String        @map("booking_id")
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  method          PaymentMethod
  amountUsd       Decimal       @db.Decimal(14, 2) @map("amount_usd")
  amountVes       Decimal       @db.Decimal(14, 2) @map("amount_ves")
  exchangeRateId  String        @map("exchange_rate_id")
  exchangeRate    ExchangeRate  @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  rate            Decimal       @db.Decimal(18, 4)
  valueDate       DateTime      @db.Date @map("value_date")
  reference       String?
  status          PaymentStatus @default(PENDING)
  reportedBy      String        @map("reported_by")
  reviewedBy      String?       @map("reviewed_by")
  reviewedAt      DateTime?     @map("reviewed_at")
  rejectionReason String?       @map("rejection_reason")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  refunds         Refund[]
  documents       Document[]

  @@index([bookingId])
  @@index([tenantId, status, createdAt])
  @@index([exchangeRateId])
  @@map("payments")
}

model Refund {
  id             String       @id
  tenantId       String       @map("tenant_id")
  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId      String       @map("payment_id")
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bookingId      String       @map("booking_id")
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  amountUsd      Decimal      @db.Decimal(14, 2) @map("amount_usd")
  amountVes      Decimal      @db.Decimal(14, 2) @map("amount_ves")
  exchangeRateId String       @map("exchange_rate_id")
  exchangeRate   ExchangeRate @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  rate           Decimal      @db.Decimal(18, 4)
  valueDate      DateTime     @db.Date @map("value_date")
  reason         String
  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  documents      Document[]
  dispatch       RefundDispatch?

  @@unique([paymentId])
  @@index([bookingId])
  @@index([tenantId])
  @@map("refunds")
}

/// Intención de reembolso registrada ANTES de llamar al proveedor (F-FINAL-003).
/// La fila se confirma con la cancelación; el despacho externo ocurre después
/// del commit y su resultado se escribe aquí. Append-only en el sentido de que
/// nunca se borra: un resultado no registrado se conserva como PENDING.
model RefundDispatch {
  refundId          String               @id @map("refund_id")
  tenantId          String               @map("tenant_id")
  organization      Organization         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId         String               @map("payment_id")
  bookingId         String               @map("booking_id")
  status            RefundDispatchStatus @default(PENDING)
  providerReference String?              @map("provider_reference")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  refund            Refund               @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([paymentId])
  @@map("refund_dispatches")
}

enum RefundDispatchStatus {
  PENDING
  COMPLETED
}

model Document {
  id         String           @id
  tenantId   String           @map("tenant_id")
  organization Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingId  String           @map("booking_id")
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentId  String?          @map("payment_id")
  payment    Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refundId   String?          @map("refund_id")
  refund     Refund?          @relation(fields: [refundId], references: [id], onDelete: Restrict)
  type       DocumentType
  number     Int
  fileUrl    String?          @map("file_url")
  language   DocumentLanguage @default(ES)
  status     DocumentStatus   @default(PENDING)
  issuedAt   DateTime?        @map("issued_at")
  error      String?
  createdAt  DateTime         @default(now()) @map("created_at")

  @@unique([tenantId, type, number])
  @@index([bookingId])
  @@index([paymentId])
  @@index([refundId])
  @@index([tenantId, status])
  @@map("documents")
}

model DocumentCounter {
  tenantId     String         @map("tenant_id")
  organization Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         DocumentType
  nextValue    Int            @default(1) @map("next_value")

  @@id([tenantId, type])
  @@map("document_counters")
}

model NotificationLog {
  id        String             @id
  tenantId  String             @map("tenant_id")
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dedupeKey String             @unique @map("dedupe_key")
  template  String
  recipient String
  locale    String
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  lastError String?            @map("last_error")
  createdAt DateTime           @default(now()) @map("created_at")
  sentAt    DateTime?          @map("sent_at")

  @@index([tenantId, status])
  @@map("notification_logs")
}
