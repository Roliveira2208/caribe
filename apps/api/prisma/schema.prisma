// Esquema de las tablas de Better Auth (core + plugins organization, admin y
// twoFactor), generado con el CLI oficial del adaptador de Prisma:
//
//   pnpm dlx @better-auth/cli@1.4.21 generate --config auth.ts --output schema.prisma -y
//
// con un auth.ts que monta betterAuth({ database: prismaAdapter(..., {
// provider: "postgresql" }), plugins: [organization(), admin(), twoFactor()] });
// (ese auth.ts se crea en T-F0-5). No editar a mano: regenerar y validar el
// diff con `prisma migrate dev`.
//
// Adaptado al formato de Prisma 7: generador prisma-client (el CLI escribe
// prisma-client-js) y la URL del datasource vive en prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id
  name             String
  email            String
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  role             String?
  banned           Boolean?     @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?     @default(false)
  // Idioma de la interfaz (additionalFields de Better Auth, T-F1-1a). Lo
  // genera el CLI a partir de auth.ts; no editar a mano.
  locale           String?      @default("es")
  sessions         Session[]
  accounts         Account[]
  members          Member[]
  invitations      Invitation[]
  twofactors       TwoFactor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                     String    @id
  accountId              String
  providerId             String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  // Relación 1:1 con la tabla propia tenant_settings. El CLI de Better Auth
  // NO genera este campo (ni el modelo TenantSettings): al regenerar el
  // esquema hay que volver a añadirlo para que `prisma migrate diff` quede
  // limpio con la FK a organization.id.
  tenantSettings TenantSettings?

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// Tabla propia de Caribe (no de Better Auth): rastro inmutable de acciones
// sensibles (specs/audit). Sin relaciones Prisma a User/Organization a
// proposito: la historia de auditoria sobrevive al borrado de usuarios y
// agencias, y tocar los modelos generados por el CLI de Better Auth los
// haria perder campos en la proxima regeneracion. La coherencia de
// tenant_id/actor_id la garantiza la capa de aplicacion (interceptor de
// T-F0-9), que toma la organizacion activa de la sesion verificada.
//
// RLS (migracion SQL, invisible para Prisma): las politicas comparan
// tenant_id con el GUC app.tenant_id que fija TenantService por
// transaccion; app.platform='on' habilita el contexto de plataforma.
// caribe_app (NOBYPASSRLS, no duena) siempre respeta las politicas.
model AuditLog {
  id       String   @id
  tenantId String?  @map("tenant_id")
  actorId  String?  @map("actor_id")
  action   String
  entity   String
  entityId String   @map("entity_id")
  before   Json?
  after    Json?
  ip       String?
  at       DateTime @default(now())

  @@index([tenantId])
  @@map("audit_logs")
}

// Tabla propia de Caribe (no de Better Auth): intentos y resultados de las
// escrituras administrativas de Better Auth y de los rechazos por segundo
// factor (delta de audit, T-F1-0b). Separada de audit_logs a proposito:
// audit_logs conserva la accion sensible confirmada con antes/despues y un
// intento NUNCA se escribe alli. Append-only con trigger y RLS por tenant_id
// (migracion SQL, invisible para Prisma). Dos filas por intento unidas por
// correlation_id: phase attempt y phase result.
model AuthEvent {
  id            String   @id
  tenantId      String?  @map("tenant_id")
  correlationId String   @map("correlation_id")
  phase         String
  actorId       String?  @map("actor_id")
  route         String
  method        String
  ip            String?
  outcome       String?
  errorCode     String?  @map("error_code")
  errorStatus   Int?     @map("error_status")
  errorName     String?  @map("error_name")
  entity        String?
  entityId      String?  @map("entity_id")
  at            DateTime @default(now())

  @@index([tenantId])
  @@index([correlationId])
  @@index([at, id])
  @@map("auth_events")
}

// Modo de cobro de la agencia (T-F1-1a, specs/auth-access y design §2.1).
// AUTO cobra en línea; MANUAL exige aprobación del admin. La base impone el
// enum: cualquier otro valor es imposible incluso por SQL directo.
enum PaymentMode {
  AUTO
  MANUAL
}

// Ajustes operativos de la agencia (T-F1-1a, design §2.1): tabla propia 1:1
// con organization.id, separada del modelo que genera Better Auth. Las
// columnas de contacto son opcionales; los defaults de negocio son 30
// minutos, cobro AUTO y USD. La base refuerza los límites con CHECK
// (hold_minutes 5-1440 y base_currency ISO de 3 mayúsculas) y RLS forzada
// con política de agencia (FOR ALL) y de plataforma (solo lectura), en la
// migración SQL invisible para Prisma.
model TenantSettings {
  tenantId     String      @id @map("tenant_id")
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  holdMinutes  Int         @default(30) @map("hold_minutes")
  paymentMode  PaymentMode @default(AUTO) @map("payment_mode")
  baseCurrency String      @default("USD") @map("base_currency")
  legalName    String?     @map("legal_name")
  rif          String?
  address      String?
  phone        String?
  email        String?
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("tenant_settings")
}
